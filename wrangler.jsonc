{
  // Cloudflare Worker settings. Cloudflare rebuilds and publishes on every push to GitHub.
  "name": "fantasy",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // only these paths run code; everything else is served as plain files (free)
    "run_worker_first": ["/api/*", "/el-api/*", "/el-live/*"]
  },
  // every 10 min: start the next round 3 h before its first game if 2 votes haven't done it already
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "elf", "database_id": "eafaa209-73e7-43ed-98bb-36dd48cd0f2e" }
  ],
  // branch previews (not main): same database as the live league, so previews show the real data
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_id": "eafaa209-73e7-43ed-98bb-36dd48cd0f2e" }
    ]
  }
}
